{
  "enabled": true,
  "name": "No childId",
  "description": "The identifier childId is forbidden (use profileId, playerId, sessionId). Flag it as soon as it appears.",
  "version": "1",
  "when": { "type": "fileEdited", "patterns": ["src/**/*.ts", "src/**/*.tsx", "content/**/*.yaml", "docs/**/*.md"] },
  "then": {
    "type": "askAgent",
    "prompt": "Search the edited file for the identifier `childId` (any casing). If present, replace it with the correct identifier (profileId, playerId or sessionId, per .kiro/steering/tech.md). If absent, do nothing and say nothing."
  }
}
